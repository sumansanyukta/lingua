# Clerk — publishable key (safe to expose in the client bundle)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Stream — Client key (non-secret, used to initialize the SDK)
STREAM_API_KEY=

# Stream — SERVER-ONLY secret. Do NOT commit. Only lives on the backend
# that issues Stream tokens. Keep this value in your local .env only.
STREAM_API_SECRET=
